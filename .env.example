# Copy to .env.local (git-ignored). Both from the Supabase dashboard.
# Leave unset to run the site on the built-in seed events with no admin.
#
# Project URL: https://<project-id>.supabase.co (the id is in the dashboard address bar)
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser. Never use the secret key here.
VITE_SUPABASE_PUBLISHABLE=
